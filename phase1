    cuisine: 'North Indian' | 'South Indian' | 'Other';
    ingredients: { ingredientId: string; quantity: number; unit: 'g' | 'pcs' | 'mL' }[];
    instructions: string[];
}

// --- ZUSTAND: AUTH STORE (store/authStore.ts) ---
interface AuthState {
  isAuthenticated: boolean;
  user: User | null;
  isLoading: boolean;
  error: string | null;
}

interface AuthActions {
  login: (email: string) => Promise<void>;
  register: (email: string, householdSize: number) => Promise<void>;
  logout: () => void;
  checkAuth: () => void;
  toggleDarkMode: () => void;
}

const useAuthStore = create<AuthState & AuthActions>((set, get) => ({
  isAuthenticated: false,
  user: null,
  isLoading: true,
  error: null,
  login: async (email) => {
    set({ isLoading: true, error: null });
    try {
      await new Promise(resolve => setTimeout(resolve, 1000));
      const storedUsers = JSON.parse(localStorage.getItem('pantryveda_users') || '[]');
      const existingUser = storedUsers.find((u: User) => u.email === email);
      if (existingUser) {
        localStorage.setItem('pantryveda_session', JSON.stringify(existingUser));
        set({ isAuthenticated: true, user: existingUser, isLoading: false });
      } else {
        throw new Error("User not found. Please register.");
      }
    } catch (err: any) {
      set({ error: err.message, isLoading: false });
    }
  },
  register: async (email, householdSize) => {
    set({ isLoading: true, error: null });
    try {
      await new Promise(resolve => setTimeout(resolve, 1000));
      const storedUsers = JSON.parse(localStorage.getItem('pantryveda_users') || '[]');
      if (storedUsers.some((u: User) => u.email === email)) {
        throw new Error("An account with this email already exists.");
      }
      const newUser: User = {
        id: `user_${Date.now()}`,
        email,
        householdSize,
        preferences: { darkMode: false, notifications: true },
        dietaryRestrictions: [],
      };
      const updatedUsers = [...storedUsers, newUser];
      localStorage.setItem('pantryveda_users', JSON.stringify(updatedUsers));
      localStorage.setItem('pantryveda_session', JSON.stringify(newUser));
      set({ isAuthenticated: true, user: newUser, isLoading: false });
    } catch (err: any) {
      set({ error: err.message, isLoading: false });
    }
  },
  logout: () => {
    localStorage.removeItem('pantryveda_session');
    set({ isAuthenticated: false, user: null });
  },
  checkAuth: () => {
    try {
        const sessionUser = JSON.parse(localStorage.getItem('pantryveda_session') || 'null');
        if (sessionUser) {
            set({ isAuthenticated: true, user: sessionUser, isLoading: false });
        } else {
            set({ isLoading: false });
        }
    } catch (error) {
        console.error("Failed to parse user session:", error);
        set({ isLoading: false });
    }
  },
  toggleDarkMode: () => {
    set(state => {
        if (!state.user) return state;
        const updatedUser = {
            ...state.user,
            preferences: {
                ...state.user.preferences,
                darkMode: !state.user.preferences.darkMode
            }
        };
        localStorage.setItem('pantryveda_session', JSON.stringify(updatedUser));
        const storedUsers = JSON.parse(localStorage.getItem('pantryveda_users') || '[]');
        const userIndex = storedUsers.findIndex((u: User) => u.id === updatedUser.id);
        if (userIndex !== -1) {
            storedUsers[userIndex] = updatedUser;
            localStorage.setItem('pantryveda_users', JSON.stringify(storedUsers));
        }
        return { ...state, user: updatedUser };
    });
  }
}));

