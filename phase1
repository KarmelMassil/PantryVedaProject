  email: string;
  preferences: {
    darkMode: boolean;
    notifications: boolean;
  };
  householdSize: number;
  dietaryRestrictions: string[];
}

interface Ingredient {
  id: string;
  name: string;
  category: 'Vegetable' | 'Fruit' | 'Spice' | 'Dairy' | 'Grain' | 'Meat' | 'Other';
  shelfLifeDays: number; // Average shelf life in days
}

interface PantryItem {
  id: string;
  ingredientId: string;
  userId: string;
  quantity: number;
  unit: 'g' | 'kg' | 'pcs' | 'L' | 'mL';
  purchaseDate: string; // ISO string
