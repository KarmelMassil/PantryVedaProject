                    <button onClick={onClose}><X size={24} className="text-gray-500 dark:text-gray-400" /></button>
                </div>

                <p className="mb-4 text-gray-700 dark:text-gray-300">{recipe.description}</p>

                <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <h4 className="font-semibold text-lg mb-2">Ingredients</h4>
                        <ul className="space-y-1">
                            {recipe.ingredients.map(req => {
                                const pantryItem = pantryItems.find(p => p.ingredientId === req.ingredientId);
                                const hasItem = pantryItem && pantryItem.quantity > 0;
                                return (
                                    <li key={req.ingredientId} className={`flex items-center gap-2 ${hasItem ? 'text-green-600 dark:text-green-400' : 'text-red-500 dark:text-red-400'}`}>
                                        {hasItem ? '✓' : '✗'} 
                                        <span>{ingredients.find(i=>i.id === req.ingredientId)?.name}</span>
                                        <span className="text-gray-500 dark:text-gray-400 text-sm">({req.quantity}{req.unit})</span>
                                    </li>
                                );
                            })}
                        </ul>
                    </div>
                    <div>
                        <h4 className="font-semibold text-lg mb-2">Instructions</h4>
                         <ol className="list-decimal list-inside space-y-2 text-gray-700 dark:text-gray-300">
                             {recipe.instructions.map((step, index) => <li key={index}>{step}</li>)}
                         </ol>
                    </div>
                </div>

                 <div className="mt-6 flex justify-end">
                    <button onClick={onClose} className="bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-2 px-4 rounded-lg">Close</button>
                </div>
            </div>
        </div>
    );
};

const RecipeSuggestionsView = () => {
    const { pantryItems, recipes } = usePantryStore();

    const suggestedRecipes = useMemo(() => {
        if (pantryItems.length === 0) return [];
        
        const availableIngredientIds = new Set(pantryItems.map(item => item.ingredientId));

        return recipes.map(recipe => {
            let missingCount = 0;
            for (const required of recipe.ingredients) {
                if (!availableIngredientIds.has(required.ingredientId)) {
                    missingCount++;
                }
            }
            return { recipe, missingCount, canMake: missingCount === 0 };
        }).sort((a, b) => a.missingCount - b.missingCount);

    }, [pantryItems, recipes]);

    return (
        <div className="bg-white dark:bg-slate-800 p-6 rounded-xl shadow-lg border border-gray-200 dark:border-slate-700">
            <div className="flex justify-between items-center mb-4">
                <h3 className="font-semibold text-xl">Recipe Suggestions</h3>
            </div>
            {pantryItems.length === 0 ? (
                 <div className="text-center text-gray-500 dark:text-gray-400 py-8">
                     <UtensilsCrossed size={48} className="mx-auto text-gray-400" />
                     <p className="mt-4">Add items to your pantry to get recipe suggestions.</p>
                 </div>
            ) : (
                <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                    {suggestedRecipes.map(({recipe, missingCount, canMake}) => (
                        <RecipeCard key={recipe.id} recipe={recipe} missingCount={missingCount} canMake={canMake} />
                    ))}
                </div>
            )}
        </div>
    );
};


