// --- ZUSTAND: PANTRY STORE (store/pantryStore.ts) ---
interface PantryState {
    pantryItems: PantryItem[];
    ingredients: Ingredient[];
    recipes: Recipe[];
    isLoading: boolean;
    error: string | null;
}

interface PantryActions {
    fetchPantry: (userId: string) => void;
    addItem: (item: Omit<PantryItem, 'id'>) => void;
    updateItem: (itemId: string, updates: Partial<PantryItem>) => void;
    deleteItem: (itemId: string) => void;
}

const usePantryStore = create<PantryState & PantryActions>((set) => ({
    pantryItems: [],
    ingredients: MASTER_INGREDIENTS,
    recipes: MASTER_RECIPES,
    isLoading: false,
    error: null,
    fetchPantry: (userId) => {
        set({ isLoading: true });
        const allItems = JSON.parse(localStorage.getItem('pantryveda_items') || '[]');
        const userItems = allItems.filter((item: PantryItem) => item.userId === userId);
        set({ pantryItems: userItems, isLoading: false });
    },
    addItem: (item) => {
        set(state => {
            const newItem: PantryItem = { ...item, id: `item_${Date.now()}` };
            const allItems = JSON.parse(localStorage.getItem('pantryveda_items') || '[]');
            const updatedItems = [...allItems, newItem];
            localStorage.setItem('pantryveda_items', JSON.stringify(updatedItems));
            return { ...state, pantryItems: [...state.pantryItems, newItem] };
        });
    },
    updateItem: (itemId, updates) => {
        set(state => {
            const allItems = JSON.parse(localStorage.getItem('pantryveda_items') || '[]') as PantryItem[];
            const itemIndex = allItems.findIndex(item => item.id === itemId);
            if (itemIndex !== -1) {
                allItems[itemIndex] = { ...allItems[itemIndex], ...updates };
                localStorage.setItem('pantryveda_items', JSON.stringify(allItems));
                return {
                    ...state,
                    pantryItems: state.pantryItems.map(pItem => 
                        pItem.id === itemId ? { ...pItem, ...updates } : pItem
                    )
                };
            }
            return state;
        });
    },
    deleteItem: (itemId) => {
        set(state => {
            const allItems = JSON.parse(localStorage.getItem('pantryveda_items') || '[]') as PantryItem[];
            const updatedItems = allItems.filter(item => item.id !== itemId);
            localStorage.setItem('pantryveda_items', JSON.stringify(updatedItems));
            return { ...state, pantryItems: state.pantryItems.filter(pItem => pItem.id !== itemId) };
        });
    }
}));


